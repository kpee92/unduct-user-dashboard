# Next.js Static Export - Minimal Safe Mode
# Created by Antigravity

Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. CRITICAL: Allow access to _next directory
# This allows the browser to load your JavaScript files.
RewriteRule ^_next/ - [L]

# 2. Handle Directory Index (Trailing Slash)
# If a directory exists, allow Apache to serve index.html automatically.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Handle Files
# If a file exists, serve it.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 4. HTTPS Force (Standard Safe Rule)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 5. Clean URL Handling (Optional, but good for Next.js)
# If request is for a missing file, check if it's an HTML file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 6. 404 Fallback
ErrorDocument 404 /404.html
